{
  "name": "api-spec",
  "version": "1.0.0",
  "private": true,
  "description": "REST API契約(openapi.yaml)の正本と、そこから生成される型定義。",
  "main": "generated/types.ts",
  "types": "generated/types.ts",
  "type": "module",
  "exports": {
    "./generated/types.js": "./generated/types.ts"
