# デプロイ用の環境変数（`pnpm stack:deploy -- --stage <stage>` が読み込みます）。
# コピーして .env を作成: cp .env.example .env（.env は .gitignore 済み。コミットしない）
#
# ここに書かないもの:
#   - Sera の API キー / シークレット … デプロイ後に Secrets Manager へ直接設定（README 参照）
#   - AWS の認証情報 … AWS CLI のプロファイル / SSO を使う

# --- AWS ---
CDK_DEFAULT_REGION=ap-northeast-1
# AWS_PROFILE=your-profile

# --- Privy（https://dashboard.privy.io で取得）---
# フロントエンドのビルド時に埋め込まれる（公開される値）
VITE_PRIVY_APP_ID=
# バックエンドの JWT 検証用。検証キー（公開鍵）であり秘密鍵ではない
PRIVY_APP_ID=
PRIVY_VERIFICATION_KEY=

# --- Ethereum Sepolia の RPC URL（送金の検証・レシート確認に使用）---
# APIキーがURLに含まれる場合は取り扱い注意
SEPOLIA_RPC_URL=

# --- Bedrock（任意。未設定なら Amazon Nova 2 Lite / ap-northeast-1）---
# BEDROCK_MODEL_ID=jp.amazon.nova-2-lite-v1:0
# BEDROCK_REGION=ap-northeast-1

# --- sera-mcp（任意）---
# POLICY_DRY_RUN=false